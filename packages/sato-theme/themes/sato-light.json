    "ivory4": "#e5d9c1",
    "ivory5": "#d9caae",
    "ivory6": "#c9b799",
    "ivory7": "#a99479",
    "ivory8": "#7d6b52",
    "ivory11": "#5a4a38",
    "ivory12": "#1c1815",
