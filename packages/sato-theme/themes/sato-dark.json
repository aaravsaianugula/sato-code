{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "emberBase": "#e39a5f",
    "emberDeep": "#c9773a",
    "emberSoft": "#f4b98a",
    "canvas1": "#1c1815",
    "canvas2": "#221d19",
    "canvas3": "#2a231e",
    "canvas4": "#332b25",
    "canvas5": "#3d332b",
    "canvas6": "#4a3f36",
    "canvas7": "#5a4d43",
    "canvas8": "#7a6a5c",
    "canvas11": "#a19487",
    "canvas12": "#efe6d7",
    "ivory": "#efe6d7",
    "moss": "#8bbf85",
    "amberDim": "#c9a86a",
    "clay": "#c95a5a",
    "peach": "#f4b98a",
    "sage": "#a3b58a",
    "harbor": "#7fb2b5",
    "plum": "#b48ac0"
  },
  "theme": {
    "primary": { "dark": "emberBase", "light": "emberDeep" },
    "secondary": { "dark": "harbor", "light": "harbor" },
    "accent": { "dark": "emberSoft", "light": "emberDeep" },
    "error": { "dark": "clay", "light": "clay" },
    "warning": { "dark": "amberDim", "light": "amberDim" },
    "success": { "dark": "moss", "light": "moss" },
    "info": { "dark": "harbor", "light": "harbor" },
    "text": { "dark": "canvas12", "light": "canvas1" },
    "textMuted": { "dark": "canvas11", "light": "canvas7" },
    "background": { "dark": "canvas1", "light": "ivory" },
    "backgroundPanel": { "dark": "canvas2", "light": "ivory" },
    "backgroundElement": { "dark": "canvas3", "light": "ivory" },
    "border": { "dark": "canvas7", "light": "canvas5" },
    "borderActive": { "dark": "canvas8", "light": "canvas6" },
    "borderSubtle": { "dark": "canvas5", "light": "canvas4" },
    "diffAdded": { "dark": "moss", "light": "moss" },
    "diffRemoved": { "dark": "clay", "light": "clay" },
    "diffContext": { "dark": "canvas11", "light": "canvas7" },
    "diffHunkHeader": { "dark": "canvas11", "light": "canvas7" },
    "diffHighlightAdded": { "dark": "sage", "light": "moss" },
    "diffHighlightRemoved": { "dark": "peach", "light": "clay" },
    "diffAddedBg": { "dark": "#243024", "light": "#e3ecdd" },
    "diffRemovedBg": { "dark": "#3a221e", "light": "#f5dcd6" },
    "diffContextBg": { "dark": "canvas2", "light": "ivory" },
    "diffLineNumber": { "dark": "canvas8", "light": "canvas7" },
    "diffAddedLineNumberBg": { "dark": "#1e2620", "light": "#d5dfcd" },
    "diffRemovedLineNumberBg": { "dark": "#301a18", "light": "#e7c8c2" },
    "markdownText": { "dark": "canvas12", "light": "canvas1" },
    "markdownHeading": { "dark": "emberBase", "light": "emberDeep" },
    "markdownLink": { "dark": "emberBase", "light": "emberDeep" },
    "markdownLinkText": { "dark": "harbor", "light": "harbor" },
    "markdownCode": { "dark": "moss", "light": "moss" },
    "markdownBlockQuote": { "dark": "amberDim", "light": "amberDim" },
    "markdownEmph": { "dark": "amberDim", "light": "amberDim" },
    "markdownStrong": { "dark": "emberSoft", "light": "emberDeep" },
    "markdownHorizontalRule": { "dark": "canvas7", "light": "canvas7" },
    "markdownListItem": { "dark": "emberBase", "light": "emberDeep" },
    "markdownListEnumeration": { "dark": "harbor", "light": "harbor" },
    "markdownImage": { "dark": "emberBase", "light": "emberDeep" },
    "markdownImageText": { "dark": "harbor", "light": "harbor" },
    "markdownCodeBlock": { "dark": "canvas12", "light": "canvas1" },
    "syntaxComment": { "dark": "canvas8", "light": "canvas7" },
    "syntaxKeyword": { "dark": "plum", "light": "plum" },
    "syntaxFunction": { "dark": "emberBase", "light": "emberDeep" },
    "syntaxVariable": { "dark": "clay", "light": "clay" },
    "syntaxString": { "dark": "moss", "light": "moss" },
    "syntaxNumber": { "dark": "peach", "light": "emberDeep" },
    "syntaxType": { "dark": "amberDim", "light": "amberDim" },
    "syntaxOperator": { "dark": "harbor", "light": "harbor" },
    "syntaxPunctuation": { "dark": "canvas11", "light": "canvas7" }
  }
}
